# 查看串口设备端口
ls /dev/ttyACM*

# 查找摄像头
lerobot-find-cameras opencv

# 无摄像头遥操
lerobot-teleoperate \
    --fps=15 \
    --robot.type=so101_follower \
    --robot.port=/dev/ttyACM0 \
    --robot.id=zihao_follower_arm \
    --teleop.type=so101_leader \
    --teleop.port=/dev/ttyACM1 \
    --teleop.id=zihao_leader_arm

# 带摄像头遥操
lerobot-teleoperate \
    --fps=30 \
    --robot.type=so101_follower \
    --robot.port=/dev/ttyACM0 \
    --robot.id=zihao_follower_arm \
    --robot.cameras="{ wrist: {type: opencv, index_or_path: /dev/video0, width: 1280, height: 720, fps: 30, fourcc: "MJPG"}}" \
    --teleop.type=so101_leader \
    --teleop.port=/dev/ttyACM1 \
    --teleop.id=zihao_leader_arm \
    --display_data=true


# 多摄像头遥操
lerobot-teleoperate \
    --fps=15 \
    --robot.type=so101_follower \
    --robot.port=/dev/ttyACM0 \
    --robot.id=zihao_follower_arm \
    --robot.cameras="{ wrist: {type: opencv, index_or_path: /dev/video0, width: 1280, height: 720, fps: 30, fourcc: "MJPG"}, side: {type: opencv, index_or_path: /dev/video2, width: 1920, height: 1080, fps: 30, fourcc: "MJPG"}}" \
    --teleop.type=so101_leader \
    --teleop.port=/dev/ttyACM1 \
    --teleop.id=zihao_leader_arm \
    --display_data=true


# 采集数据集
lerobot-record \
    --robot.type=so101_follower \
    --robot.port=/dev/ttyACM0 \
    --robot.id=zihao_follower_arm \
    --robot.cameras="{ wrist: {type: opencv, index_or_path: /dev/video0, width: 1280, height: 720, fps: 30, fourcc: "MJPG"}, side: {type: opencv, index_or_path: /dev/video2, width: 1920, height: 1080, fps: 30, fourcc: "MJPG"}}" \
    --teleop.type=so101_leader \
    --teleop.port=/dev/ttyACM1 \
    --teleop.id=zihao_leader_arm \
    --display_data=false \
    --dataset.repo_id=ZhangYong/lerobot_dataset_a \
    --dataset.num_episodes=30 \
    --dataset.single_task="ZyTestTask" \
    --dataset.push_to_hub=false \
    --dataset.episode_time_s=30 \
    --dataset.reset_time_s=3

# 查看回放数据集
lerobot-dataset-viz --repo-id ZhangYong/lerobot_dataset_a_20260921_164625 --episode-index=1

# 训练
## ACT 算法训练
lerobot-train \
  --dataset.repo_id=ZhangYong/lerobot_dataset_a_20260921_164625 \
  --dataset.root="$HOME/.cache/huggingface/lerobot/ZhangYong/lerobot_dataset_a_20260921_164625" \
  --dataset.streaming=false \
  --policy.type=act \
  --output_dir=output_lerobot_train/a \
  --job_name=test_job \
  --policy.device=cuda \
  --wandb.enable=false \
  --wandb.project=Lerobot_ZhangYong_Project \
  --policy.push_to_hub=false \
  --steps=20000 \
  --batch_size=16

## smolVLA 模型微调
lerobot-train \
  --policy.path=lerobot/smolvla_base \
  --dataset.repo_id=ZhangYong/lerobot_dataset_a_20260921_164625 \
  --dataset.root="$HOME/.cache/huggingface/lerobot/ZhangYong/lerobot_dataset_a_20260921_164625" \
  --dataset.streaming=false \
  --rename_map='{"observation.images.side":"observation.images.camera1","observation.images.wrist":"observation.images.camera2"}' \
  --policy.empty_cameras=0 \
  --output_dir=output_lerobot_train/shake/smolvla_A \
  --job_name=test_job \
  --policy.device=cuda \
  --wandb.enable=false \
  --wandb.project=Lerobot_ZhangYong_Project \
  --policy.push_to_hub=false \
  --steps=20000 \
  --batch_size=16

## smolVLA 从头开始训练
lerobot-train \
  --dataset.repo_id=ZhangYong/lerobot_dataset_a_20260921_164625 \
  --dataset.root="$HOME/.cache/huggingface/lerobot/ZhangYong/lerobot_dataset_a_20260921_164625" \
  --dataset.streaming=false \
  --policy.type=smolvla \
  --output_dir=~/output_lerobot_train/grab/smolvla_A \
  --job_name=shake_smolvla_a \
  --policy.device=cuda \
  --wandb.enable=true \
  --wandb.project=Lerobot_Zihao_Project \
  --policy.push_to_hub=false \
  --steps=40000 \
  --batch_size=8

# 推理 
## ACT 算法推理 
## 注意：1）接入 so101_follower (对应串口号 /dev/ttyACM0), 2）接入 so101_leader (对应串口号 /dev/ttyACM1)，3）接入 wrist camera，对应 /dev/video0，4）接入 side camera，对应 /dev/video2
lerobot-rollout  \
  --strategy.type=base \
  --robot.type=so101_follower \
  --robot.port=/dev/ttyACM0 \
  --robot.cameras="{ wrist: {type: opencv, index_or_path: /dev/video0, width: 1280, height: 720, fps: 30, fourcc: "MJPG"}, side: {type: opencv, index_or_path: /dev/video2, width: 1920, height: 1080, fps: 30, fourcc: "MJPG"}}" \
  --robot.id=zihao_follower_arm \
  --display_data=false \
  --task="TestTask" \
  --duration=300 \
  --policy.path=/home/zy/workspace/lerobot/output_lerobot_train/a/checkpoints/last/pretrained_model

## smolVLA 算法推理 
lerobot-rollout \
  --strategy.type=base \
  --inference.type=rtc \
  --inference.rtc.execution_horizon=10 \
  --inference.rtc.max_guidance_weight=10.0 \
  --robot.type=so101_follower \
  --robot.port=/dev/ttyACM0 \
  --robot.cameras='{"wrist": {"type": "opencv", "index_or_path": "/dev/video0", "width": 1280, "height": 720, "fps": 30, "fourcc": "MJPG"}, "side": {"type": "opencv", "index_or_path": "/dev/video2", "width": 1920, "height": 1080, "fps": 30, "fourcc": "MJPG"}}' \
  --robot.id=zihao_follower_arm \
  --policy.path=/home/zy/workspace/lerobot/output_lerobot_train/shake/smolvla_A/checkpoints/020000/pretrained_model \
  --device=cuda \
  --display_data=false \
  --task="TestTask" \
  --duration=300 \
  --rename_map='{"observation.images.side":"observation.images.camera1","observation.images.wrist":"observation.images.camera2"}' \
  --policy.empty_cameras=0